---
import '../styles/global.css';
import { config, url as toUrl } from '../lib/data.js';
const siteName = config.nazev || 'Rodokmen';
const { title, description = config.popis || siteName, wide = false, full = false } = Astro.props;
const path = Astro.url.pathname;
const groups = [
  [[toUrl('/'), 'Úvod'], ...(config.maPribeh ? [[toUrl('/pribehy/'), config.pribeh?.menu || 'Příběh rodu']] : []), [toUrl('/zajimavosti/'), 'Zajímavosti']],
  [[toUrl('/rody/'), 'Rody'], [toUrl('/mapa/'), 'Mapa'], [toUrl('/strom/'), 'Strom'], [toUrl('/strom-v2/'), 'Strom (interaktivní)'], [toUrl('/vejir/'), 'Vějíř'], [toUrl('/predci/'), 'Předci'], [toUrl('/zapisy/'), 'Zápisy'], [toUrl('/hledame/'), 'Co hledáme']],
  [[toUrl('/hledat/'), 'Hledat']],
];
const current = (linkUrl) => {
  const rootUrl = toUrl('/');
  if (linkUrl === rootUrl) {
    return path === rootUrl || path === rootUrl.replace(/\/$/, '') ? 'page' : undefined;
  }
  return path.startsWith(linkUrl) ? 'page' : undefined;
};
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='15' fill='%235B4A3A'/><path d='M16 8v16M9 14l7-6 7 6' stroke='%23FBF8F2' stroke-width='2.5' fill='none'/></svg>" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={toUrl('/')}>{siteName}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav">
        {groups.map((g, i) => (
          <div class={`nav-group nav-group-${i + 1}`}>
            {g.map(([linkUrl, label]) => <a href={linkUrl} aria-current={current(linkUrl)}>{label}</a>)}
          </div>
        ))}
      </nav>
    </header>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      btn?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
    <main class={full ? 'full' : wide ? 'wide' : ''} data-pagefind-body>
      <slot />
    </main>
    {!full && <footer class="site-footer">
      {config.zapati || 'Dohledáno v digitalizovaných matrikách'} · rodinný web
    </footer>}
  </body>
</html>
