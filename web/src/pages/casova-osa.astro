---
import Base from '../layouts/Base.astro';
import { people, families, lines, href, root } from '../lib/data.js';

// 1. Line lookup per person
const personLineMap = {};
for (const lineSlug in lines) {
  const line = lines[lineSlug];
  for (const personSlug of line.people || []) {
    personLineMap[personSlug] = {
      slug: lineSlug,
      name: line.name,
      color: line.color || '#4A7BB0'
    };
  }
}

// 2. Extract years & date calculations
function parseDateParts(raw) {
  if (!raw) return { dateStr: null, year: null, full: false, display: '' };
  const ddm = raw.match(/(\d{1,2})\.\s*(\d{1,2})\.\s*(\d{4})/);
  if (ddm) {
    const day = ddm[1].padStart(2, '0');
    const month = ddm[2].padStart(2, '0');
    const year = parseInt(ddm[3], 10);
    return { dateStr: `${year}-${month}-${day}`, year, full: true, display: ddm[0] };
  }
  const ym = raw.match(/(\d{4})/);
  if (ym) {
    const year = parseInt(ym[1], 10);
    return { dateStr: `${year}-06-01`, year, full: false, display: String(year) };
  }
  return { dateStr: null, year: null, full: false, display: '' };
}

// Year propagation for people with missing dates
const knownYears = {};
const peopleEntries = Object.entries(people);

for (const [slug, p] of peopleEntries) {
  const b = parseDateParts(p.details?.birth || p.y || p.years);
  const d = parseDateParts(p.details?.death);
  if (b.year) knownYears[slug] = b.year;
  else if (d.year) knownYears[slug] = d.year - 65;
}

for (let pass = 0; pass < 3; pass++) {
  for (const [slug, p] of peopleEntries) {
    if (!knownYears[slug]) {
      for (const ch of p.children || []) {
        if (knownYears[ch]) {
          knownYears[slug] = knownYears[ch] - 30;
          break;
        }
      }
      if (!knownYears[slug] && p.father && knownYears[p.father]) knownYears[slug] = knownYears[p.father] + 30;
      if (!knownYears[slug] && p.mother && knownYears[p.mother]) knownYears[slug] = knownYears[p.mother] + 30;
    }
  }
}

// Build groups and data records
const peopleData = [];

for (const [slug, p] of peopleEntries) {
  const bInfo = parseDateParts(p.details?.birth || p.y || p.years);
  const dInfo = parseDateParts(p.details?.death);

  const birthYear = bInfo.year || knownYears[slug];
  if (!birthYear) continue;

  const isLiving = (p.gen === 0) || (birthYear >= 1935 && !dInfo.year);
  const startStr = bInfo.dateStr || `${birthYear}-01-01`;
  let endStr;
  let estimated = false;

  if (dInfo.dateStr) {
    endStr = dInfo.dateStr;
  } else if (isLiving) {
    endStr = new Date().toISOString().slice(0, 10);
  } else {
    const deathYear = birthYear + 68;
    endStr = `${deathYear}-01-01`;
    estimated = true;
  }

  if (endStr <= startStr) {
    const sY = parseInt(startStr.slice(0, 4), 10);
    endStr = `${sY + 1}-01-01`;
  }

  const lineInfo = personLineMap[slug] || { slug: 'hlavni', name: 'Hlavní rodina', color: '#4A7BB0' };
  const sex = p.sex === 'F' ? 'F' : 'M';
  const gen = p.gen ?? 0;

  let ageStr = '';
  if (bInfo.year && dInfo.year) {
    ageStr = ` (${dInfo.year - bInfo.year} let)`;
  }

  const yearsLabel = `${bInfo.year || `~${birthYear}`} – ${isLiving ? 'dnes' : (dInfo.year || `~${birthYear + 68}`)}`;

  peopleData.push({
    id: slug,
    name: p.name,
    roz: p.roz || '',
    birthYear: birthYear,
    startStr: startStr,
    endStr: endStr,
    estimated: estimated,
    sex: sex,
    gen: gen,
    lineSlug: lineInfo.slug,
    lineName: lineInfo.name,
    lineColor: lineInfo.color,
    url: href.person(slug),
    yearsLabel: yearsLabel,
    ageStr: ageStr,
    job: p.details?.job || '',
    home: p.details?.home || '',
    birthDisplay: bInfo.display,
    birthFull: p.details?.birth || bInfo.display,
    deathDisplay: dInfo.display,
    deathFull: p.details?.death || dInfo.display,
    hasExactBirth: !!bInfo.dateStr,
    hasExactDeath: !!dInfo.dateStr,
    isLiving: isLiving
  });
}

// Marriages
const marriagesData = [];
const familyValues = Object.values(families);

for (const fam of familyValues) {
  if (fam.marriage && fam.marriage.length > 0) {
    for (let mIdx = 0; mIdx < fam.marriage.length; mIdx++) {
      const mStr = fam.marriage[mIdx];
      const mDate = parseDateParts(mStr);
      if (mDate.dateStr) {
        const fatherObj = fam.father ? people[fam.father] : null;
        const motherObj = fam.mother ? people[fam.mother] : null;

        marriagesData.push({
          id: `marr-${fam.id}-${mIdx}`,
          father: fam.father,
          mother: fam.mother,
          fatherName: fatherObj?.name || 'neznámý',
          motherName: motherObj?.name || 'neznámá',
          dateStr: mDate.dateStr,
          display: mDate.display,
          text: mStr.replace(/^[×xX]\s*/, '')
        });
      }
    }
  }
}

// Historical milestones across all rows
const historicalMilestones = [
  {
    id: 'hist-1',
    start: '1781-11-01',
    end: '1781-11-02',
    content: '<span class="hist-label">1781 Zrušení nevolnictví</span>',
    type: 'background',
    className: 'hist-marker'
  },
  {
    id: 'hist-2',
    start: '1848-03-01',
    end: '1848-10-31',
    content: '<span class="hist-label">1848 Revoluce / Konec roboty</span>',
    type: 'background',
    className: 'hist-zone hist-1848'
  },
  {
    id: 'hist-3',
    start: '1914-07-28',
    end: '1918-11-11',
    content: '<span class="hist-label">1914–1918 1. světová válka</span>',
    type: 'background',
    className: 'hist-zone hist-ww1'
  },
  {
    id: 'hist-4',
    start: '1918-10-28',
    end: '1918-10-29',
    content: '<span class="hist-label">1918 Vznik ČSR</span>',
    type: 'background',
    className: 'hist-marker'
  },
  {
    id: 'hist-5',
    start: '1939-03-15',
    end: '1945-05-08',
    content: '<span class="hist-label">1939–1945 2. světová válka</span>',
    type: 'background',
    className: 'hist-zone hist-ww2'
  }
];

// Initial sorting: oldest ancestors first
peopleData.sort((a, b) => a.birthYear - b.birthYear);

const clientData = {
  people: peopleData,
  marriages: marriagesData,
  historical: historicalMilestones,
  lines: Object.entries(lines).map(([slug, l]) => ({
    slug,
    name: l.name,
    color: l.color || '#4A7BB0'
  }))
};

const allNames = peopleData.map((p) => p.name).sort((a, b) => a.localeCompare(b, 'cs'));
---

<Base title="Časová osa rodiny" full>
  <!-- Modern Toolbar -->
  <div class="timeline-bar">
    <div class="tb-left">
      <div class="tb-title-group">
        <strong>Časová osa rodiny</strong>
        <span class="tb-badge" id="visible-count-badge">{peopleData.length} osob</span>
      </div>

      <!-- Quick Legend -->
      <div class="tb-legend">
        <span class="legend-item" title="Kulatý bod na začátku linie"><span class="legend-dot dot-birth"></span> Narození</span>
        <span class="legend-item" title="Kosočtverec na linii"><span class="legend-dot dot-marriage"></span> Sňatek</span>
        <span class="legend-item" title="Tmavý bod na konci linie"><span class="legend-dot dot-death"></span> Úmrtí</span>
        <span class="legend-item" title="Čárkovaná linie"><span class="legend-line-est"></span> Odhad dožití</span>
      </div>
    </div>

    <div class="tb-center">
      <!-- Search -->
      <form class="tb-search" autocomplete="off" id="tl-search-form">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input id="tl-search-input" list="tl-names" placeholder="Hledat osobu…" aria-label="Hledat osobu v časové ose" />
        <datalist id="tl-names">
          {allNames.map((n) => <option value={n} />)}
        </datalist>
      </form>

      <!-- Line Filter -->
      <div class="filter-dropdown-wrap">
        <select id="tl-line-filter" class="tl-select" aria-label="Filtrovat rodovou linii">
          <option value="all">Všechny rody</option>
          {clientData.lines.map((l) => (
            <option value={l.slug}>{l.name}</option>
          ))}
        </select>
      </div>

      <!-- Sorting -->
      <div class="filter-dropdown-wrap">
        <select id="tl-sort-select" class="tl-select" aria-label="Řazení osob">
          <option value="birth-asc" selected>Od nejstarších</option>
          <option value="birth-desc">Od nejmladších</option>
          <option value="name-asc">Podle jména (A–Z)</option>
          <option value="line">Podle rodů</option>
        </select>
      </div>
    </div>

    <div class="tb-right">
      <!-- Quick Century Jumps -->
      <div class="tb-jumps">
        <span class="small muted jumps-label">Skok:</span>
        <button type="button" class="btn-jump" data-year="1680" title="17. století">17. stol.</button>
        <button type="button" class="btn-jump" data-year="1750" title="18. století">18. stol.</button>
        <button type="button" class="btn-jump" data-year="1850" title="19. století">19. stol.</button>
        <button type="button" class="btn-jump" data-year="1930" title="20. století">20. stol.</button>
        <button type="button" class="btn-jump" data-year="2000" title="Současnost">Dnes</button>
        <button type="button" class="btn-jump btn-fit" id="btn-fit-all" title="Zobrazit celé období">Vše</button>
      </div>

      <!-- Zoom -->
      <div class="tb-zoom">
        <button type="button" id="btn-tl-zoom-in" title="Přiblížit časovou osu">+</button>
        <button type="button" id="btn-tl-zoom-out" title="Oddálit časovou osu">−</button>
      </div>
    </div>
  </div>

  <!-- Stage container for vis-timeline -->
  <div id="vis-timeline-container" class="timeline-stage"></div>

  <!-- Client-side bundle -->
  <script define:vars={{ clientData }}>
    window.__TL_DATA__ = clientData;
  </script>

  <script>
    import { Timeline, DataSet } from 'vis-timeline/standalone';
    import 'vis-timeline/styles/vis-timeline-graph2d.min.css';

    const rawData = (window as any).__TL_DATA__;
    const container = document.getElementById('vis-timeline-container');

    if (!container || !rawData) {
      console.error('Timeline container or data missing.');
    } else {
      // 1. Build left group labels
      function createGroupContent(p: any) {
        const sexClass = p.sex === 'F' ? 'sex-f' : 'sex-m';
        const sexIcon = p.sex === 'F' ? '♀' : '♂';
        return `
          <div class="tl-row-label" data-slug="${p.id}" title="${p.name} (${p.yearsLabel})">
            <span class="tl-row-line-indicator" style="background:${p.lineColor}"></span>
            <span class="tl-row-sex ${sexClass}">${sexIcon}</span>
            <a href="${p.url}" class="tl-row-name" title="Otevřít profil: ${p.name}">${p.name}</a>
            <span class="tl-row-years">${p.yearsLabel}</span>
          </div>
        `;
      }

      const allGroups = rawData.people.map((p: any) => ({
        id: p.id,
        content: createGroupContent(p),
        name: p.name,
        order: p.birthYear,
        birthYear: p.birthYear,
        sex: p.sex,
        gen: p.gen,
        lineSlug: p.lineSlug,
        lineName: p.lineName,
        lineColor: p.lineColor,
        url: p.url,
        yearsLabel: p.yearsLabel
      }));

      // 2. Build items (lifespan bars + points + background milestones)
      const allItems: any[] = [];

      for (const p of rawData.people) {
        // Lifespan line tooltip
        const lineTooltip = `
          <div class="tt-box">
            <div class="tt-title">${p.name}${p.roz ? ` (roz. ${p.roz})` : ''}</div>
            <div class="tt-dates">Dožití: ${p.yearsLabel}${p.ageStr}</div>
            ${p.job ? `<div class="tt-sub">💼 ${p.job}</div>` : ''}
            ${p.home ? `<div class="tt-sub">📍 ${p.home}</div>` : ''}
            <div class="tt-line-badge" style="background:${p.lineColor}22;color:${p.lineColor};border-color:${p.lineColor}66">${p.lineName}</div>
            <div class="tt-click-hint">Klepnutím otevřete profil osoby →</div>
          </div>
        `;

        // Range line (clean, colored, no text inside)
        allItems.push({
          id: `life-${p.id}`,
          group: p.id,
          personSlug: p.id,
          url: p.url,
          content: '',
          start: p.startStr,
          end: p.endStr,
          type: 'range',
          title: lineTooltip,
          className: `tl-life-bar sex-${p.sex.toLowerCase()} line-${p.lineSlug} ${p.estimated ? 'estimated' : ''}`,
          style: `background:${p.lineColor}; border-color:${p.lineColor};`
        });

        // Birth point
        if (p.hasExactBirth) {
          const birthTooltip = `
            <div class="tt-box">
              <div class="tt-title">⭐ Narození · ${p.name}</div>
              <div class="tt-dates">${p.birthFull}</div>
              <div class="tt-click-hint">Klepnutím otevřete profil osoby →</div>
            </div>
          `;
          allItems.push({
            id: `birth-${p.id}`,
            group: p.id,
            personSlug: p.id,
            url: p.url,
            content: '',
            start: p.startStr,
            type: 'point',
            title: birthTooltip,
            className: 'tl-dot tl-dot-birth'
          });
        }

        // Death point
        if (p.hasExactDeath) {
          const deathTooltip = `
            <div class="tt-box">
              <div class="tt-title">✝ Úmrtí · ${p.name}</div>
              <div class="tt-dates">${p.deathFull}${p.ageStr}</div>
              <div class="tt-click-hint">Klepnutím otevřete profil osoby →</div>
            </div>
          `;
          allItems.push({
            id: `death-${p.id}`,
            group: p.id,
            personSlug: p.id,
            url: p.url,
            content: '',
            start: p.endStr,
            type: 'point',
            title: deathTooltip,
            className: 'tl-dot tl-dot-death'
          });
        }
      }

      // Marriage points
      for (const m of rawData.marriages) {
        const marrTooltip = `
          <div class="tt-box">
            <div class="tt-title">💍 Sňatek · ${m.fatherName} & ${m.motherName}</div>
            <div class="tt-dates">${m.display}${m.text ? ` (${m.text})` : ''}</div>
            <div class="tt-click-hint">Klepnutím otevřete profil →</div>
          </div>
        `;

        if (m.father) {
          allItems.push({
            id: `marr-${m.father}-${m.id}`,
            group: m.father,
            personSlug: m.father,
            url: rawData.people.find((p: any) => p.id === m.father)?.url,
            content: '',
            start: m.dateStr,
            type: 'point',
            title: marrTooltip,
            className: 'tl-dot tl-dot-marriage'
          });
        }

        if (m.mother) {
          allItems.push({
            id: `marr-${m.mother}-${m.id}`,
            group: m.mother,
            personSlug: m.mother,
            url: rawData.people.find((p: any) => p.id === m.mother)?.url,
            content: '',
            start: m.dateStr,
            type: 'point',
            title: marrTooltip,
            className: 'tl-dot tl-dot-marriage'
          });
        }
      }

      // Historical milestones
      for (const hm of rawData.historical) {
        allItems.push(hm);
      }

      const groupsDataSet = new DataSet(allGroups);
      const itemsDataSet = new DataSet(allItems);

      const options: any = {
        start: new Date(1740, 0, 1),
        end: new Date(2028, 11, 31),
        min: new Date(1640, 0, 1),
        max: new Date(2035, 11, 31),
        zoomMin: 1000 * 60 * 60 * 24 * 365 * 3,   // 3 years
        zoomMax: 1000 * 60 * 60 * 24 * 365 * 400, // 400 years
        orientation: 'top',
        stack: false,                              // Put markers directly along the lifespan line!
        horizontalScroll: true,
        verticalScroll: true,
        zoomKey: 'ctrlKey',
        moveable: true,
        zoomable: true,
        selectable: true,
        multiselect: false,
        showCurrentTime: true,
        locale: 'cs',
        margin: {
          item: { horizontal: 0, vertical: 0 },
          axis: 6
        },
        tooltip: {
          followMouse: true,
          overflowMethod: 'cap',
          delay: 100
        }
      };

      const timeline = new Timeline(container, itemsDataSet, groupsDataSet, options);

      // Click on item -> navigate to person profile
      timeline.on('select', (properties) => {
        if (properties.items && properties.items.length > 0) {
          const selectedId = properties.items[0];
          const item = itemsDataSet.get(selectedId);
          if (item && item.url) {
            window.location.href = item.url;
          }
        }
      });

      // Filtering & Sorting function
      function applyFilterAndSort() {
        const lineVal = (document.getElementById('tl-line-filter') as HTMLSelectElement)?.value || 'all';
        const sortVal = (document.getElementById('tl-sort-select') as HTMLSelectElement)?.value || 'birth-asc';
        const searchVal = ((document.getElementById('tl-search-input') as HTMLInputElement)?.value || '').trim().toLowerCase();

        let filtered = allGroups.filter((g: any) => {
          if (lineVal !== 'all' && g.lineSlug !== lineVal) return false;
          if (searchVal && !g.name.toLowerCase().includes(searchVal)) return false;
          return true;
        });

        // Apply sort
        if (sortVal === 'birth-asc') {
          filtered.sort((a: any, b: any) => a.birthYear - b.birthYear);
        } else if (sortVal === 'birth-desc') {
          filtered.sort((a: any, b: any) => b.birthYear - a.birthYear);
        } else if (sortVal === 'name-asc') {
          filtered.sort((a: any, b: any) => a.name.localeCompare(b.name, 'cs'));
        } else if (sortVal === 'line') {
          filtered.sort((a: any, b: any) => a.lineName.localeCompare(b.lineName, 'cs') || a.birthYear - b.birthYear);
        }

        groupsDataSet.clear();
        groupsDataSet.add(filtered);

        // Update badge
        const badge = document.getElementById('visible-count-badge');
        if (badge) {
          badge.textContent = `${filtered.length} osob`;
        }

        // If search returned exactly 1 person, focus on their start year
        if (searchVal && filtered.length === 1) {
          const person = filtered[0];
          const sY = person.birthYear;
          timeline.setWindow(new Date(sY - 20, 0, 1), new Date(sY + 70, 11, 31), {
            animation: { duration: 500, easingFunction: 'easeInOutQuad' }
          });
        }
      }

      document.getElementById('tl-line-filter')?.addEventListener('change', applyFilterAndSort);
      document.getElementById('tl-sort-select')?.addEventListener('change', applyFilterAndSort);

      const searchInput = document.getElementById('tl-search-input') as HTMLInputElement;
      searchInput?.addEventListener('input', applyFilterAndSort);
      document.getElementById('tl-search-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        applyFilterAndSort();
      });

      // Quick jumps
      document.querySelectorAll('.btn-jump[data-year]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const year = parseInt(btn.getAttribute('data-year') || '1850', 10);
          timeline.setWindow(new Date(year - 20, 0, 1), new Date(year + 60, 11, 31), {
            animation: { duration: 500, easingFunction: 'easeInOutQuad' }
          });
        });
      });

      document.getElementById('btn-fit-all')?.addEventListener('click', () => {
        timeline.fit({ animation: { duration: 600, easingFunction: 'easeInOutQuad' } });
      });

      // Zoom buttons
      document.getElementById('btn-tl-zoom-in')?.addEventListener('click', () => {
        timeline.zoomIn(0.4, { animation: { duration: 250 } });
      });

      document.getElementById('btn-tl-zoom-out')?.addEventListener('click', () => {
        timeline.zoomOut(0.4, { animation: { duration: 250 } });
      });
    }
  </script>

  <style is:global>
    /* Top Toolbar */
    .timeline-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.45rem 1rem;
      background: var(--bg-alt, #F6F1EA);
      border-bottom: 1px solid var(--border, #E4DCBE);
      gap: 0.8rem;
      flex-wrap: wrap;
      font-size: 0.85rem;
      z-index: 20;
    }

    .tb-left {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .tb-title-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .tb-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      background: #EAE2D0;
      color: #70583A;
    }

    .tb-legend {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.74rem;
      color: #6A5844;
      background: rgba(255, 255, 255, 0.6);
      padding: 0.2rem 0.55rem;
      border-radius: 5px;
      border: 1px solid rgba(228, 220, 190, 0.6);
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .legend-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .legend-dot.dot-birth {
      background: #10B981;
      border: 1px solid #FFFFFF;
      box-shadow: 0 0 2px rgba(0,0,0,0.3);
    }

    .legend-dot.dot-marriage {
      background: #F59E0B;
      border-radius: 2px;
      transform: rotate(45deg);
      border: 1px solid #FFFFFF;
      box-shadow: 0 0 2px rgba(0,0,0,0.3);
    }

    .legend-dot.dot-death {
      background: #1F2937;
      border: 1px solid #FFFFFF;
      box-shadow: 0 0 2px rgba(0,0,0,0.3);
    }

    .legend-line-est {
      display: inline-block;
      width: 14px;
      height: 0;
      border-top: 2px dashed #8C7B68;
    }

    .tb-center {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .tb-search {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 8px;
      color: #8C7B68;
      pointer-events: none;
    }

    .tb-search input {
      padding: 0.22rem 0.5rem 0.22rem 1.7rem;
      border: 1px solid var(--border, #D8CEBC);
      border-radius: 4px;
